# Production Bot server
PORT=8080
BOT_SERVER_HOST=0.0.0.0
BOT_WEB_DIR=dist
BOT_DATA_PATH=/var/lib/decibel-dashboard/bot-state.local

# Strongly recommended in production.
# The dashboard can read without it, but write actions need this token when set.
BOT_API_TOKEN=change-this-long-random-token

# Background runner. Set false only if another real runner owns bot runtime updates.
BOT_RUNNER_ENABLED=true
BOT_RUNNER_INTERVAL_MS=5000

# Optional backup dir. Default is next to BOT_DATA_PATH.
BOT_BACKUP_DIR=/var/lib/decibel-dashboard/backups

# Runner source modes:
# mock = simulated local runtime, readonly = reserved for real market/account read-only, live = reserved for real execution runner.
BOT_RUNNER_SOURCE=mock
